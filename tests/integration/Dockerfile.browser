FROM debian:trixie-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    golang-go gcc libc6-dev libpam0g-dev libopus-dev pkg-config ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /repo/station
COPY station/go.mod station/go.sum ./
RUN go mod download
COPY station/ ./
RUN CGO_ENABLED=1 go test -c -tags=nolibopusfile,browserfixture -trimpath \
    -o /dxberry-browser-fixture ./internal/httpapi \
 && CGO_ENABLED=1 go build -tags=nolibopusfile -trimpath -o /dxberryd ./cmd/dxberryd

FROM debian:trixie-slim AS browser
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash chromium nodejs npm curl ca-certificates libopus0 libpam0g libpam-modules libpam-runtime nginx-light openssl libnss3-tools passwd && \
    rm -rf /var/lib/apt/lists/*
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --global --ignore-scripts playwright@1.62.1
ENV NODE_PATH=/usr/local/lib/node_modules
RUN groupadd -f sudo && useradd -m -G sudo fixtureadmin && useradd -m fixturebrowser
WORKDIR /repo
COPY --from=build /dxberryd /opt/dxberry/bin/dxberryd
COPY provision/templates/pam-dxberry /etc/pam.d/dxberry
COPY provision/templates/nginx-dxberry.conf /fixture/nginx-dxberry.conf
COPY tests/integration/browser-login.js tests/integration/browser-login.sh tests/integration/
COPY --from=build /dxberry-browser-fixture /usr/local/bin/dxberry-browser-fixture
COPY tests/page_smoke.js tests/page_smoke.js
COPY tests/integration/browser-ptt.js tests/integration/browser-ptt.sh tests/integration/
COPY tests/integration/browser-radio-monitor.js tests/integration/browser-wsjtx.js tests/integration/browser-wsjtx.sh tests/integration/
CMD ["bash", "tests/integration/browser-ptt.sh"]

FROM browser AS webkit
RUN playwright install --with-deps webkit
ENV DXB_BROWSER_ENGINE=webkit
CMD ["bash", "tests/integration/browser-wsjtx.sh"]

FROM browser AS standard
