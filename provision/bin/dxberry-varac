#!/bin/bash
# VarAC keeps its database and settings beside its executable.
set -euo pipefail
[[ $# == 1 && $1 =~ ^[a-z][a-z0-9]{0,11}$ ]]
src=${DXB_APPS_OPT:-/opt/dxberry-apps}/varac
dir=$HOME/varac/$1
umask 077
mkdir -p "$dir"
cd "$dir"
if ! cmp -s "$src/VarAC" VarAC; then
  install -m 700 "$src/VarAC" VarAC.new
  mv -fT VarAC.new VarAC
fi
for file in License.txt THIRD-PARTY-LICENSES.txt README.txt; do cp -f "$src/$file" "$file"; done
for file in VarAC_cat_commands.ini VarAC_UI_languages.ini VarAC_templates.ini; do
  # Refresh an untouched default on upgrade and keep an operator-edited copy.
  if [[ ! -f $file ]] || cmp -s "$file" ".$file.default"; then cp "$src/$file" "$file"; fi
  cp "$src/$file" ".$file.default"
done
export ICED_BACKEND=tiny-skia
if [[ -z ${DXB_XARA_RX_CALL:-} ]]; then exec ./VarAC; fi

# The receive trial shares the radio session's capture stream. ALSA discards modem playback.
modem=${DXB_APPS_OPT:-/opt/dxberry-apps}/xara/xara
[[ -x $modem ]] || { echo "Missing native XARA modem: $modem" >&2; exit 1; }
export PULSE_SOURCE=${CARD:?missing radio sound card}.in
"$modem" --call "$DXB_XARA_RX_CALL" --hf 500 --audio alsa --capture pulse --playback null \
  --addr 127.0.0.1 --port 8300 --kiss-port 8100 &
modem_pid=$!
client_pid=
stop_children() {
  kill "$modem_pid" ${client_pid:+"$client_pid"} 2>/dev/null || :
  wait "$modem_pid" ${client_pid:+"$client_pid"} 2>/dev/null || :
}
trap stop_children EXIT
trap 'exit 0' HUP INT TERM
./VarAC &
client_pid=$!
wait -n "$modem_pid" "$client_pid"
