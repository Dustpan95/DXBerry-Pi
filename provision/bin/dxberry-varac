#!/bin/bash
# VarAC keeps its database and settings beside its executable.
set -euo pipefail
[[ $# == 1 && $1 =~ ^[a-z][a-z0-9]{0,11}$ ]]
src=${DXB_APPS_OPT:-/opt/dxberry-apps}/varac
dir=$HOME/varac/$1
umask 077
mkdir -p "$dir"
cd "$dir"
if ! cmp -s "$src/VarAC" VarAC; then
  install -m 700 "$src/VarAC" VarAC.new
  mv -fT VarAC.new VarAC
fi
for file in License.txt THIRD-PARTY-LICENSES.txt README.txt; do cp -f "$src/$file" "$file"; done
for file in VarAC_cat_commands.ini VarAC_UI_languages.ini VarAC_templates.ini; do
  # Refresh an untouched default on upgrade and keep an operator-edited copy.
  if [[ ! -f $file ]] || cmp -s "$file" ".$file.default"; then cp "$src/$file" "$file"; fi
  cp "$src/$file" ".$file.default"
done
export ICED_BACKEND=tiny-skia
if [[ ${DXB_VARAC_MODEM:-} != xara ]]; then exec ./VarAC; fi

# The session owns the radio's PulseAudio server. Keep the XARA trial receive-only.
modem=${DXB_APPS_OPT:-/opt/dxberry-apps}/xara/xara
[[ -x $modem ]] || { echo "Install XARA under Programs before selecting it for VarAC." >&2; exit 6; }
if (exec 3<>/dev/tcp/127.0.0.1/8300) 2>/dev/null; then
  echo "VarAC's HF modem port 8300 is already in use." >&2
  exit 6
fi
call=
if [[ -r $HOME/.config/dxberry-xara/$1.call ]]; then read -r call < "$HOME/.config/dxberry-xara/$1.call"; fi
# Profiles created before the companion was added already have a VarAC callsign.
if [[ -z $call || $call == N0CALL ]]; then
  if [[ -r VarAC.ini ]]; then
    call=$(awk -F= 'tolower($1) == "mycall" {sub(/\r$/, "", $2); print toupper($2); exit}' VarAC.ini)
  fi
fi
[[ $call =~ ^[A-Z0-9]{3,7}(-[0-9]{1,2})?$ && $call != N0CALL ]] ||
  { echo "Set your station callsign before starting the XARA modem." >&2; exit 6; }
PULSE_SOURCE=${1^^}.in "$modem" --call "$call" --hf 500 --audio alsa \
  --capture pulse --playback null --addr 127.0.0.1 --port 8300 --kiss-port 8100 &
xara_pid=$!
varac_pid=
# Invoked by the EXIT trap.
# shellcheck disable=SC2317
cleanup() {
  kill "$xara_pid" ${varac_pid:+"$varac_pid"} 2>/dev/null || true
  wait "$xara_pid" ${varac_pid:+"$varac_pid"} 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' TERM INT HUP
for ((attempt=0; attempt<60; attempt++)); do
  kill -0 "$xara_pid" 2>/dev/null || exit 6
  if (exec 3<>/dev/tcp/127.0.0.1/8300) 2>/dev/null; then
    ./VarAC &
    varac_pid=$!
    wait -n "$xara_pid" "$varac_pid"
    exit
  fi
  sleep 0.1
done
echo "XARA did not open VarAC's HF command port." >&2
exit 6
