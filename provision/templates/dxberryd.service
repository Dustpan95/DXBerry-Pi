# Installed by DXBerry-Pi. The station app: the one web service behind nginx (design 5.1).
# Runs as root by design: every function behind the login needs it, and the terminal (a real
# login shell) and the CLIs need a writable system, so there is no ProtectSystem/ProtectHome.
# Deliberately NOT set: PrivateDevices/DevicePolicy (the terminal needs /dev/ptmx and /dev/pts),
# PrivateTmp (program windows share /tmp/.X11-unix with their session units), RestrictNamespaces.
# Set to no on purpose: NoNewPrivileges and RestrictSUIDSGID (login -f sets up the session).
[Unit]
Description=DXBerry-Pi station app
After=network.target nginx.service

[Service]
Type=simple
ExecStart=/opt/dxberry/bin/dxberryd
Environment=GOMAXPROCS=2
Restart=always
RestartSec=2
MemoryMax=400M
TasksMax=256
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=no
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
