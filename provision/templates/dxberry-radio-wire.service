[Unit]
Description=DXBerry-Pi radio wiring: wire owned radios once their applications are up
Documentation=file:///opt/dxberry/bin/dxberry-radio
After=dxberry-radio-hotplug.service graywolf.service

[Service]
Type=oneshot
# a re-wire waits up to 120 s per radio for the owner's API; systemd's 90 s default would kill it
TimeoutStartSec=600
ExecStart=/opt/dxberry/bin/dxberry-radio hotplug

[Install]
WantedBy=multi-user.target
